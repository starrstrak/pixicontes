# Optionnel. La clé OpenAI se saisit normalement dans l'interface admin (stockée chiffrée dans data/).
# OPENAI_API_KEY=
PORT=8080
# Dossier des données locales (histoires, images, audios, base SQLite)
# DATA_DIR=./data
# Certificats HTTPS locaux (mkcert) pour le micro sur la tablette
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem
